
<div class="page-header">
  <div>
    <h1>Activities</h1>
    <% if Current.user.role == "organizer" %>
      <p class="page-subtitle">
        Browse and manage volunteer activities.
      </p>
    <% else %>
      <p class="page-subtitle">
        Discover volunteer opportunities and make a difference.
      </p>
    <% end %>
  </div>
  <% if Current.user.role == "organizer" %>
    <%= link_to new_activity_path, class: "btn btn-primary" do %>
      <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5v14M5 12h14"/>
      </svg>
      <span>Create Activity</span>
    <% end %>
  <% end %>
</div>


<section id="activities-list">
  <% if @activities.any? %>
    <div class="card-grid activity-grid">
      <% @activities.each do |activity| %>
        <article class="card activity-card" id="activity-<%= activity.id %>">
          <div class="activity-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="2"/>
              <path d="M16 3v4M8 3v4M3 10h18"/>
            </svg>
          </div>
          <h2 class="activity-card-title">
            <%= link_to activity.title, activity_path(activity) %>
          </h2>
          <div class="activity-card-details">
            <div class="activity-card-detail">
              <svg class="activity-detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="3" width="16" height="18" rx="2"/>
                <path d="M9 21v-4h6v4M8 7h2M14 7h2M8 11h2M14 11h2"/>
              </svg>
              <p>
                Organization: <%= activity.organization.name %>
              </p>
            </div>
            <div class="activity-card-detail">
              <svg class="activity-detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <p>
                Location: <%= activity.location %>
              </p>
            </div>
          </div>
          <p class="activity-card-description">
            <%= activity.description %>
          </p>
          <div class="activity-card-footer">
            <%= link_to activity_path(activity), class: "btn btn-primary btn-block" do %>
              <span>View Activity</span>
              <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14m-7-7 7 7-7 7"/>
              </svg>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2"/>
          <path d="M16 3v4M8 3v4M3 10h18M8 15h2M14 15h2"/>
        </svg>
      </div>
      <h2 class="empty-state-title">No activities available.</h2>
      <% if Current.user.role == "organizer" && @activities.any? %>
        <p class="empty-state-description">
          Create a volunteer activity to start managing shifts and volunteer signups.
        </p>
        <%= link_to new_activity_path, class: "btn btn-primary" do %>
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span>Create Activity</span>
        <% end %>
      <% else %>
        <p class="empty-state-description">
          There are no volunteer activities available at the moment. Please check back later.
        </p>
        <%= link_to dashboard_path, class: "btn btn-secondary" do %>
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5m7-7-7 7 7 7"/>
          </svg>
          <span>Back to Dashboard</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
