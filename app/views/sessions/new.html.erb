
<section class="auth-card" data-controller="demo-account">
  <div class="auth-header">
    <div class="auth-logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/>
      </svg>
    </div>
    <h1>Welcome back</h1>
    <p>Sign in to your VolunteerHub account.</p>
  </div>
  <%= form_with url: session_path, class: "auth-form" do |form| %>
    <div class="auth-field">
      <%= form.label :email_address, "Email Address" %>
      <div class="auth-input-wrapper">
        <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="m3 7 9 6 9-6"/>
        </svg>
        <%= form.email_field :email_address,
                             required: true,
                             autofocus: true,
                             autocomplete: "username",
                             placeholder: "Enter your email address",
                             value: params[:email_address],
                             class: "auth-input",
                             data: { demo_account_target: "email" } %>
      </div>
    </div>
    <div class="auth-field">
      <%= form.label :password, "Password" %>
      <div class="auth-input-wrapper">
        <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="11" width="16" height="10" rx="2"/>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
        <%= form.password_field :password,
                                required: true,
                                autocomplete: "current-password",
                                placeholder: "Enter your password",
                                maxlength: 72,
                                class: "auth-input",
                                data: { demo_account_target: "password" } %>
      </div>
    </div>
    <div class="auth-options">
      <%= link_to "Forgot password?", new_password_path %>
    </div>
    <%= form.submit "Sign in", class: "btn btn-primary btn-block auth-submit" %>
  <% end %>

  <div class="demo-accounts">
    <h2>Demo Accounts</h2>
    <p>Select a demo account to fill in the login form.</p>

    <div class="demo-account-grid">
      <button type="button"
              class="btn demo-account-btn"
              data-action="click->demo-account#fill"
              data-email="volunteer1@example.com"
              data-password="password123">
        Volunteer 1
      </button>

      <button type="button"
              class="btn demo-account-btn"
              data-action="click->demo-account#fill"
              data-email="volunteer2@example.com"
              data-password="password123">
        Volunteer 2
      </button>

      <button type="button"
              class="btn demo-account-btn"
              data-action="click->demo-account#fill"
              data-email="organizer1@example.com"
              data-password="password123">
        Organizer 1
      </button>

      <button type="button"
              class="btn demo-account-btn"
              data-action="click->demo-account#fill"
              data-email="organizer2@example.com"
              data-password="password123">
        Organizer 2
      </button>
    </div>

    <p class="demo-account-note">
      Course demonstration only. Not an official CUHK service.
    </p>
  </div>

  <div class="auth-footer">
    <p>
      Don't have an account?
      <%= link_to "Sign Up", new_registration_path %>
    </p>
  </div>
</section>
