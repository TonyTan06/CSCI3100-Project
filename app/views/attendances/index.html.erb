
<%# Attendance Management 页面专用样式 %>
<%= stylesheet_link_tag "attendances", "data-turbo-track": "reload" %>

<div class="page-header attendance-page-header">
  <div>
    <p class="attendance-page-kicker">VOLUNTEER MANAGEMENT</p>
    <h1>Attendance Management</h1>
    <p class="page-subtitle">
      Review volunteer registrations and manage attendance records.
    </p>
  </div>
  <%= link_to activity_shift_path(@activity, @shift), class: "btn btn-secondary" do %>
    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5m7-7-7 7 7 7"/>
    </svg>
    <span>Back to Shift</span>
  <% end %>
</div>

<section class="card attendance-shift-card" aria-labelledby="attendance-shift-heading">
  <div class="attendance-section-heading">
    <div class="attendance-heading-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="2"/>
        <path d="M16 3v4M8 3v4M3 10h18"/>
      </svg>
    </div>
    <div>
      <h2 id="attendance-shift-heading">Shift Information</h2>
      <p>Details of the volunteer shift being managed.</p>
    </div>
  </div>
  <div class="attendance-shift-grid">
    <div class="attendance-shift-item">
      <span class="attendance-info-label">Activity:</span>
      <strong><%= @activity.title %></strong>
    </div>
    <div class="attendance-shift-item">
      <span class="attendance-info-label">Organization:</span>
      <strong><%= @activity.organization.name %></strong>
    </div>
    <div class="attendance-shift-item">
      <span class="attendance-info-label">Shift:</span>
      <strong>#<%= @shift.id %></strong>
    </div>
    <div class="attendance-shift-item">
      <span class="attendance-info-label">Start Time:</span>
      <time datetime="<%= @shift.start_time.iso8601 %>">
        <%= @shift.start_time.strftime("%Y-%m-%d %H:%M") %>
      </time>
    </div>
    <div class="attendance-shift-item">
      <span class="attendance-info-label">End Time:</span>
      <time datetime="<%= @shift.end_time.iso8601 %>">
        <%= @shift.end_time.strftime("%Y-%m-%d %H:%M") %>
      </time>
    </div>
  </div>
</section>

<%# 保留出勤更新失败时的原有错误信息 %>
<% if @signup && @signup.errors.any? %>
  <div class="validation-errors attendance-validation-errors" role="alert">
    <div class="attendance-error-heading">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 7v6M12 17h.01"/>
      </svg>
      <h2>Unable to update attendance</h2>
    </div>
    <ul>
      <% @signup.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<section id="attendance-summary" class="attendance-summary-section" aria-labelledby="attendance-summary-heading">
  <div class="attendance-section-title">
    <h2 id="attendance-summary-heading">Attendance Summary</h2>
    <p class="text-muted text-sm">
      Current attendance records for confirmed volunteers.
    </p>
  </div>
  <div class="attendance-stat-grid">
    <article class="attendance-stat-card attendance-stat-confirmed">
      <div class="attendance-stat-top">
        <span class="attendance-stat-label">Confirmed:</span>
        <span class="attendance-stat-symbol">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="m17 11 2 2 4-4"/>
          </svg>
        </span>
      </div>
      <p class="attendance-stat-value">
        <%= @attendance_summary[:confirmed] %>
      </p>
    </article>

    <article class="attendance-stat-card attendance-stat-present">
      <div class="attendance-stat-top">
        <span class="attendance-stat-label">Present:</span>
        <span class="attendance-stat-symbol">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="m8 12 3 3 5-6"/>
          </svg>
        </span>
      </div>
      <p class="attendance-stat-value">
        <%= @attendance_summary[:present] %>
      </p>
    </article>

    <article class="attendance-stat-card attendance-stat-absent">
      <div class="attendance-stat-top">
        <span class="attendance-stat-label">Absent:</span>
        <span class="attendance-stat-symbol">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="m9 9 6 6m0-6-6 6"/>
          </svg>
        </span>
      </div>
      <p class="attendance-stat-value">
        <%= @attendance_summary[:absent] %>
      </p>
    </article>

    <article class="attendance-stat-card attendance-stat-pending">
      <div class="attendance-stat-top">
        <span class="attendance-stat-label">Pending:</span>
        <span class="attendance-stat-symbol">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 7v5l3 2"/>
          </svg>
        </span>
      </div>
      <p class="attendance-stat-value">
        <%= @attendance_summary[:pending] %>
      </p>
    </article>
  </div>
</section>

<section class="card attendance-volunteers-card" aria-labelledby="attendance-volunteers-heading">
  <div class="attendance-volunteers-header">
    <div>
      <h2 id="attendance-volunteers-heading">Confirmed Volunteers</h2>
      <p class="text-muted text-sm">
        Update attendance individually for each confirmed volunteer.
      </p>
    </div>
    <span class="attendance-volunteer-count">
      <%= @attendance_summary[:confirmed] %> confirmed
    </span>
  </div>

  <% if @signups.any? %>
    <div class="attendance-table-wrapper">
      <table class="attendance-table">
        <thead>
          <tr>
            <th scope="col">Volunteer</th>
            <th scope="col">Attendance Status</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @signups.each do |signup| %>
            <tr id="attendance-signup-<%= signup.id %>">
              <td>
                <div class="attendance-volunteer">
                  <span class="attendance-volunteer-avatar" aria-hidden="true">
                    <%= signup.user.email_address.first.upcase %>
                  </span>
                  <span class="attendance-volunteer-email">
                    <%= signup.user.email_address %>
                  </span>
                </div>
              </td>
              <td>
                <span class="status-badge status-<%= signup.attendance_status %>">
                  <%= signup.attendance_status.humanize %>
                </span>
              </td>
              <td>
                <%= form_with url: activity_shift_attendance_path(@activity, @shift, signup),
                              scope: :attendance,
                              method: :patch,
                              local: true,
                              html: { class: "attendance-update-form" } do |form| %>
                  <%= form.select :attendance_status,
                                  options_for_select(
                                    [
                                      ["Pending", "pending"],
                                      ["Present", "present"],
                                      ["Absent", "absent"]
                                    ],
                                    signup.attendance_status
                                  ),
                                  {},
                                  {
                                    id: "attendance_status_#{signup.id}",
                                    class: "attendance-status-select",
                                    aria: { label: "Attendance status for #{signup.user.email_address}" }
                                  } %>
                  <%= form.submit "Update Attendance", class: "btn btn-primary btn-sm" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state attendance-empty-state">
      <div class="attendance-empty-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M17 8h6"/>
        </svg>
      </div>
      <h3 class="empty-state-title">No confirmed signups.</h3>
      <p class="empty-state-description">
        Confirmed volunteers will appear here when they register for this shift.
      </p>
    </div>
  <% end %>
</section>

<nav class="attendance-page-actions" aria-label="Attendance navigation">
  <%= link_to activity_shift_path(@activity, @shift), class: "btn btn-secondary" do %>
    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5m7-7-7 7 7 7"/>
    </svg>
    <span>Back to Shift</span>
  <% end %>
  <%= link_to activity_path(@activity), class: "btn btn-ghost" do %>
    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5m7-7-7 7 7 7"/>
    </svg>
    <span>Back to Activity</span>
  <% end %>
</nav>
