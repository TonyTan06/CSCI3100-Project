
<nav id="main-navigation" aria-label="Main navigation" class="<%= authenticated? ? 'sidebar-navigation' : 'guest-navigation' %>">
  <% if authenticated? %>
    <div class="navigation-label">WORKSPACE</div>
    <div class="navigation-links">
      <%= link_to dashboard_path, class: "nav-link #{'active' if controller_name == 'dashboards'}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        <span>Dashboard</span>
      <% end %>

      <%= link_to activities_path, class: "nav-link #{'active' if controller_name == 'activities'}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2"/>
          <path d="M16 3v4M8 3v4M3 10h18"/>
        </svg>
        <% if Current.user.role == "volunteer" %>
          <span>Browse Activities</span>
        <% elsif Current.user.role == "organizer" %>
          <span>View All Activities</span>
        <% end %>
      <% end %>

      <%# 班次总列表导航入口 %>
      <%= link_to shifts_path, class: "nav-link #{'active' if ['shifts', 'attendances', 'signups'].include?(controller_name)}" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3 2"/>
        </svg>
        <% if Current.user.role == "volunteer" %>
          <span>Browse Shifts</span>
        <% elsif Current.user.role == "organizer" %>
          <span>View All Shifts</span>
        <% end %>
      <% end %>
    </div>

    <div class="navigation-bottom">
      <%# 本地开发环境专用：快速切换测试账号 %>
      <% if Rails.env.development? && request.local? %>
        <%= form_with url: dev_switch_account_path,
                      method: :post,
                      local: true,
                      class: "dev-switch-form" do |form| %>
          <%= form.label :email_address, "Switch Test Account", class: "dev-switch-label" %>
          <%= form.select :email_address,
                          [
                            ["Volunteer 1", "volunteer1@example.com"],
                            ["Volunteer 2", "volunteer2@example.com"],
                            ["Organizer 1", "organizer1@example.com"],
                            ["Organizer 2", "organizer2@example.com"]
                          ],
                          { selected: Current.user.email_address },
                          { class: "dev-switch-select" } %>
          <%= form.submit "Switch Account", class: "btn btn-secondary btn-sm btn-block" %>
        <% end %>
      <% end %>

      <%= button_to session_path, method: :delete, class: "nav-sign-out" do %>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 17l5-5-5-5M15 12H3"/>
          <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"/>
        </svg>
        <span>Sign Out</span>
      <% end %>
    </div>
  <% else %>
    <%= link_to "Sign In", new_session_path, class: "guest-nav-link" %>
    <%= link_to "Sign Up", new_registration_path, class: "guest-nav-link guest-nav-primary" %>
  <% end %>
</nav>
