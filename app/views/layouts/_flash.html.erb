
<div id="flash-messages" class="flash-messages">
  <% if flash[:notice].present? %>
    <div class="flash-message flash-success" role="status">
      <svg class="flash-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="m8 12 3 3 5-6"/>
      </svg>
      <div class="flash-content">
        <strong>Success</strong>
        <p><%= flash[:notice] %></p>
      </div>
    </div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="flash-message flash-danger" role="alert">
      <svg class="flash-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 8v4M12 16h.01"/>
      </svg>
      <div class="flash-content">
        <strong>Something went wrong</strong>
        <p><%= flash[:alert] %></p>
      </div>
    </div>
  <% end %>
</div>
