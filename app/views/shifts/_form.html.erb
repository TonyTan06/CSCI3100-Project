
<% if shift.errors.any? %>
  <div>
    <h2>Unable to save shift</h2>

    <ul>
      <% shift.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [activity, shift], local: true do |form| %>
  <div>
    <%= form.label :start_time %>
    <%= form.datetime_local_field :start_time, required: true %>
  </div>

  <div>
    <%= form.label :end_time %>
    <%= form.datetime_local_field :end_time, required: true %>
  </div>

  <div>
    <%= form.label :capacity %>
    <%= form.number_field :capacity, min: 1, step: 1, required: true %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
