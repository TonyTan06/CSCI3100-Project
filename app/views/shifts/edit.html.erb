
<div class="page-header shift-form-page-header">
  <div>
    <p class="shift-form-kicker">SHIFT MANAGEMENT</p>
    <h1>Edit Shift</h1>
    <p class="page-subtitle">
      Update the schedule and volunteer capacity for this shift.
    </p>
  </div>
  <%= link_to activity_shift_path(@activity, @shift), class: "btn btn-secondary" do %>
    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5m7-7-7 7 7 7"/>
    </svg>
    <span>Back to Shift</span>
  <% end %>
</div>

<div class="shift-form-layout">
  <section class="card shift-form-card" aria-labelledby="shift-form-heading">
    <div class="shift-form-intro">
      <div class="shift-form-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m16 3 5 5L8 21H3v-5L16 3ZM13 6l5 5"/>
        </svg>
      </div>
      <div>
        <h2 id="shift-form-heading">Shift Details</h2>
        <p class="text-muted text-sm">
          Edit the schedule and capacity of your existing shift.
        </p>
      </div>
    </div>

    <div class="shift-form-context">
      <div class="shift-form-context-item">
        <span>Activity:</span>
        <strong><%= @activity.title %></strong>
      </div>
      <div class="shift-form-context-item">
        <span>Organization:</span>
        <strong><%= @activity.organization.name %></strong>
      </div>
    </div>

    <div class="shift-form-section">
      <div class="shift-form-section-heading">
        <h3>Current Signups</h3>
        <p>
          Review the existing volunteer registrations before updating this shift.
        </p>
      </div>
      <div class="shift-form-context">
        <div class="shift-form-context-item">
          <span>Confirmed Signups:</span>
          <strong><%= @shift.confirmed_count %></strong>
        </div>
        <div class="shift-form-context-item">
          <span>Waitlisted Signups:</span>
          <strong><%= @shift.waitlist_queue.count %></strong>
        </div>
      </div>
    </div>

    <%= render "form", activity: @activity, shift: @shift %>
  </section>

  <aside class="card shift-form-aside" aria-labelledby="shift-guide-heading">
    <div class="shift-guide-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 11v5M12 8h.01"/>
      </svg>
    </div>
    <h2 id="shift-guide-heading">Editing Tips</h2>
    <p>
      Review the current schedule and volunteer registrations before saving changes.
    </p>
    <div class="shift-guide-item">
      <span class="shift-guide-dot"></span>
      <span>Make sure the updated start and end times are valid.</span>
    </div>
    <div class="shift-guide-item">
      <span class="shift-guide-dot"></span>
      <span>Check the existing confirmed signups before changing capacity.</span>
    </div>
    <div class="shift-guide-item">
      <span class="shift-guide-dot"></span>
      <span>Review the waitlist when updating volunteer availability.</span>
    </div>
    <div class="shift-guide-note">
      Changes to this shift will be reflected in its details page after saving.
    </div>
  </aside>
</div>
